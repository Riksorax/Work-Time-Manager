<?xml version="1.0" encoding="utf-8"?>
<!-- Status-Widget (#276), Vorlage "Home Screen Widget" (Claude Design). Texte, Farben,
     Timer und Buttons setzt StatusWidgetProvider. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background"
    android:gravity="top"
    android:orientation="vertical"
    android:padding="16dp">

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal">
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center_vertical" android:orientation="horizontal">
        <ImageView
            android:id="@+id/w_logo"
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:importantForAccessibility="no"
            android:src="@mipmap/launcher_icon" />
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="8dp" android:fontFamily="sans-serif-medium" android:text="@string/widget_today" android:textColor="@color/w_text2" android:textSize="13sp" />
        </LinearLayout>
        <LinearLayout
            android:id="@+id/w_chip"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/w_chip_neutral"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="10dp"
            android:paddingTop="4dp"
            android:paddingEnd="10dp"
            android:paddingBottom="4dp">

            <ImageView
                android:id="@+id/w_dot"
                android:layout_width="8dp"
                android:layout_height="8dp"
                android:background="@drawable/w_dot_neutral"
                android:importantForAccessibility="no" />

            <TextView
                android:id="@+id/w_status"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:fontFamily="sans-serif-medium"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:textSize="13sp" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout android:id="@+id/w_main" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:gravity="bottom" android:orientation="horizontal">
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
            <FrameLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">

            <Chronometer
                android:id="@+id/w_timer"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-medium"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:textColor="@color/w_text"
                android:textSize="48sp"
                android:visibility="gone" />

            <TextView
                android:id="@+id/w_timer_static"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-medium"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:text="0:00"
                android:textColor="@color/w_text"
                android:textSize="48sp" />
        </FrameLayout>
            <TextView
            android:id="@+id/w_sub"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:textColor="@color/w_text2"
            android:textSize="13sp" />
        </LinearLayout>
        <LinearLayout android:id="@+id/w_overtime_box" android:layout_width="wrap_content" android:layout_height="wrap_content" android:gravity="end" android:orientation="vertical" android:visibility="gone">
            <TextView
            android:id="@+id/w_overtime"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:textColor="@color/w_green"
            android:textSize="16sp" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/widget_overtime" android:textColor="@color/w_text2" android:textSize="12sp" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
            android:id="@+id/w_lock_row"
            android:layout_width="match_parent"
            android:layout_height="76dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="@drawable/w_btn_neutral"
                android:gravity="center">

                <ImageView
                    android:id="@+id/w_lock_icon"
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_w_lock" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-medium"
                    android:text="@string/widget_locked"
                    android:textColor="@color/w_text"
                    android:textSize="16sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/widget_locked_hint"
                    android:textColor="@color/w_text2"
                    android:textSize="13sp" />
            </LinearLayout>
        </LinearLayout>

    <FrameLayout android:id="@+id/w_bars" android:layout_width="match_parent" android:layout_height="6dp" android:layout_marginTop="12dp">
        <ProgressBar android:id="@+id/w_bar_track" style="?android:attr/progressBarStyleHorizontal" android:layout_width="match_parent" android:layout_height="6dp" android:max="100" android:progress="0" android:progressDrawable="@drawable/w_bar_primary" />
        <ProgressBar
            android:id="@+id/w_bar_primary"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="6dp"
            android:max="100"
            android:progress="0"
            android:progressDrawable="@drawable/w_bar_primary"
            android:visibility="gone" />
        <ProgressBar
            android:id="@+id/w_bar_teal"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="6dp"
            android:max="100"
            android:progress="0"
            android:progressDrawable="@drawable/w_bar_teal"
            android:visibility="gone" />
        <ProgressBar
            android:id="@+id/w_bar_green"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="6dp"
            android:max="100"
            android:progress="0"
            android:progressDrawable="@drawable/w_bar_green"
            android:visibility="gone" />
    </FrameLayout>

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:orientation="horizontal">
        <LinearLayout
            android:id="@+id/w_btn_a"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_weight="1"
            android:layout_marginEnd="8dp"
            android:background="@drawable/w_btn_primary"
            android:gravity="center"
            android:orientation="horizontal"
            android:visibility="gone">

            <ImageView
                android:id="@+id/w_btn_a_icon"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_w_play" />

            <TextView
                android:id="@+id/w_btn_a_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:fontFamily="sans-serif-medium"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:textSize="14sp" />
        </LinearLayout>
        <LinearLayout
            android:id="@+id/w_btn_b"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_weight="1"
            android:layout_marginEnd="0dp"
            android:background="@drawable/w_btn_primary"
            android:gravity="center"
            android:orientation="horizontal"
            android:visibility="gone">

            <ImageView
                android:id="@+id/w_btn_b_icon"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_w_play" />

            <TextView
                android:id="@+id/w_btn_b_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:fontFamily="sans-serif-medium"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:textSize="14sp" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
