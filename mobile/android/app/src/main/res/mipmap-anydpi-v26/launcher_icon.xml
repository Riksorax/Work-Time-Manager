<?xml version="1.0" encoding="utf-8"?>
<!-- Von flutter_launcher_icons erzeugt, danach von Hand angepasst (#437): kein <inset>.
     Die Foreground-/Monochrome-Quellen (branding/) liegen schon in der 108-dp-Safe-Zone;
     der Paket-Standard (16 % Inset) würde das Motiv ein zweites Mal verkleinern.
     Nach einem erneuten `dart run flutter_launcher_icons` die Insets wieder entfernen. -->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
  <background android:drawable="@drawable/ic_launcher_background"/>
  <foreground android:drawable="@drawable/ic_launcher_foreground"/>
  <monochrome android:drawable="@drawable/ic_launcher_monochrome"/>
</adaptive-icon>
